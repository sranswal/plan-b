# Copy to .env and substitute your local path and selected Calendar ID.
PLAN_B_CALENDAR_PROVIDER=google
PLAN_B_GOOGLE_CLIENT_FILE='C:/private/google/credentials.json'
PLAN_B_GOOGLE_CALENDAR_ID='your-test-calendar-id@group.calendar.google.com'
PLAN_B_LIVE_TASK_MINUTES=15

# Enable only after connecting the corresponding Google account.
# PLAN_B_WEB_GOOGLE=1
# PLAN_B_WEB_GOOGLE_TASKS=1
# PLAN_B_GMAIL_EXTENSION_ID=your_edge_extension_id
# PLAN_B_GOOGLE_TASK_LIST_ID=@default
# PLAN_B_GOOGLE_TASKS_CLIENT_FILE='C:/private/google/tasks-client.json'
# GEMINI_API_KEY=
# PLAN_B_GEMINI_MODEL=gemini-3.8-flash
